{
  "identifier": "default",
  "description": "Default capability for Abundio",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "shell:allow-execute",
    "shell:allow-stdin-write",
    "dialog:allow-open",
    "notification:default"
  ]
}
